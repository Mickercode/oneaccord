# Copy to apps/api/.env for local work. Never commit a filled-in copy.

NODE_ENV=development
# If something else on your machine already owns 3000, change this and run
# the apps with a matching API_PROXY: API_PROXY=http://127.0.0.1:3100 pnpm dev
PORT=3000

# 127.0.0.1, not localhost: on Windows localhost can resolve to IPv6
# while Docker binds IPv4 only.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55433/oneaccord
REDIS_URL=redis://127.0.0.1:6379

# Signs boarding codes, gate tokens, UR Pass cookies and team sessions.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=dev-secret-change-me-before-any-real-event

# ---------------------------------------------------------------------------
# Addresses
#
# Everything is one origin in production, so PUBLIC_URL is the only address
# worth setting and the rest fall out of it:
#
#   PUBLIC_URL=https://oneaccord.ng
#     -> the attendee app at /, the team app at /team, the dashboard at
#        /admin, this API at /api, and the health check at /health
#
# Because the apps and the API share an origin, the UR Pass cookie needs no
# COOKIE_DOMAIN and no CORS allowance. Leave both alone unless you split them.
# ---------------------------------------------------------------------------
# PUBLIC_URL=https://oneaccord.ng

# In development each app runs on its own Vite port and proxies /api here,
# so these defaults are already right and need no entry:
#   WEB_URL=http://localhost:5173
#   TEAM_URL=http://localhost:5174
#   ADMIN_URL=http://localhost:5175
#   API_URL=http://localhost:3000/api

# COOKIE_DOMAIN=

# Serve the three built apps from this process. On by default in production,
# off in development where Vite serves them with hot reload. Set it true to
# try the production arrangement locally, after `pnpm build`.
# SERVE_APPS=false

# console prints to the log and sends nothing. Use resend or postmark for real.
MAIL_PROVIDER=console
MAIL_API_KEY=
MAIL_FROM=One Accord <passes@oneaccord.example>
MAIL_REPLY_TO=
