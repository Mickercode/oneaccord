# Copy to apps/api/.env for local work. Never commit a filled-in copy.

NODE_ENV=development
# If something else on your machine already owns 3000, change this and run
# the apps with a matching API_PROXY: API_PROXY=http://127.0.0.1:3100 pnpm dev
PORT=3000

# 127.0.0.1, not localhost: on Windows localhost can resolve to IPv6
# while Docker binds IPv4 only.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55433/oneaccord
REDIS_URL=redis://127.0.0.1:6379

# Signs boarding codes, gate tokens, UR Pass cookies and team sessions.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=dev-secret-change-me-before-any-real-event

# ---------------------------------------------------------------------------
# Addresses
#
# The three apps deploy on their own, so each one is named here. They are used
# for the sign-in redirect, the links in emails, and the CORS allowlist.
#
#   WEB_URL=https://oneaccord.vercel.app
#   TEAM_URL=https://oneaccord-team.vercel.app
#   ADMIN_URL=https://oneaccord-admin.vercel.app
#   API_URL=https://oneaccord-api.up.railway.app/api
#
# In development the defaults below are already right and need no entry:
#   WEB_URL=http://localhost:5173
#   TEAM_URL=http://localhost:5174
#   ADMIN_URL=http://localhost:5175
#   API_URL=http://localhost:3000/api
#
# The apps and the API are on different sites, so the UR Pass cookie cannot
# reach the API and the apps hold a bearer token instead. Put them all on one
# registrable domain and set COOKIE_DOMAIN, and the cookie takes over again.
# ---------------------------------------------------------------------------
# COOKIE_DOMAIN=

# console prints to the log and sends nothing. Use resend or postmark for real.
MAIL_PROVIDER=console
MAIL_API_KEY=
MAIL_FROM=One Accord <passes@oneaccord.example>
MAIL_REPLY_TO=
