{
  "name": "one-accord-be",
  "private": true,
  "version": "1.0.0",
  "description": "One Accord by Upper Room — registration and check-in API.",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "bash scripts/e2e.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @oa/api exec prisma migrate dev",
    "db:deploy": "pnpm --filter @oa/api exec prisma migrate deploy",
    "db:reset": "pnpm --filter @oa/api exec prisma migrate reset --force",
    "db:seed": "pnpm --filter @oa/api run seed",
    "db:studio": "pnpm --filter @oa/api exec prisma studio"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
